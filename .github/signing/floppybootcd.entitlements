<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- CPython generates and executes code at runtime (ctypes trampolines,
       PySide6/Qt's own JIT paths). Without allow-jit plus
       allow-unsigned-executable-memory the hardened runtime kills the
       process on launch. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- NOTE: com.apple.security.cs.disable-library-validation is
       deliberately NOT here. It is the usual PyInstaller recipe, but it is
       only needed when the bundle loads code signed by someone else:
       macos-sign.sh re-signs every Mach-O in the bundle — PySide6, the Qt
       frameworks, every .so, xorriso and its dylibbundler-relocated libs —
       with one Developer ID identity, so library validation is satisfied
       by the same Team ID. Apple's guidance is to re-sign dependencies
       rather than disable the check. The app loads nothing from outside
       the bundle (its only ctypes use is Windows-only, and xorriso is a
       subprocess, which library validation does not police).

       If a future dependency does need to load third-party code, the
       symptom is a launch-time crash citing "code signature ... library
       load disallowed" — see the troubleshooting note in README.md before
       reaching for this entitlement. -->

  <!-- PyInstaller's bootloader sets DYLD_LIBRARY_PATH for the child
       process it re-execs. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
